; calculator: a pocket calculator for the part of the screen it is given. Generated by scripts/gen_view.py - change that, not this.
;
; The display (two lines: the operation waiting and the number) is on top, under it a grid of 4 x 5 keys. Everything follows $view.w and
; $view.h, so it fits any rent. The application sets the properties $expr and $text and is told of a key by the event "press" (the value
; is the ASCII code of the key: 0-9 . + - * / = % and n (sign), b (erase), c (clear)).
.view   calculator
.entry  draw

.font   big,   "builtin-16"
.font   small, "builtin-8"

.prop   $expr, str[48], "",  "expr"
.prop   $text, str[24], "0", "text"

.var    $m,   int, 0         ; the margin
.var    $dh,  int, 0         ; the height of the display
.var    $kw,  int, 0         ; the size of a key (the grid, less the gaps)
.var    $kh,  int, 0
.var    $x0,  int, 0         ; the left sides of the columns
.var    $x1,  int, 0
.var    $x2,  int, 0
.var    $x3,  int, 0
.var    $y0,  int, 0         ; the tops of the rows
.var    $y1,  int, 0
.var    $y2,  int, 0
.var    $y3,  int, 0
.var    $y4,  int, 0
.var    $tw,  int, 0         ; the width of the display's texts
.var    $fw,  int, 0         ; the width of its frame

draw:
        BOX     @all, 0, 0, $view.w, $view.h, OPAQUE
        FILL    #FFFFFF

        ; the layout: 5 px around and between the keys, the display takes the top part (a fifth of the height, at least 56)
        SET     $m, 5
        SET     $dh, $view.h
        DIV     $dh, 5
        JGE     $dh, 56, .tall
        SET     $dh, 56
.tall:
        SET     $kw, $view.w
        SUB     $kw, 25
        DIV     $kw, 4
        SET     $kh, $view.h
        SUB     $kh, $dh
        SUB     $kh, 30
        DIV     $kh, 5
        SET     $x0, 5
        SET     $x1, $x0
        ADD     $x1, $kw
        ADD     $x1, 5
        SET     $x2, $x1
        ADD     $x2, $kw
        ADD     $x2, 5
        SET     $x3, $x2
        ADD     $x3, $kw
        ADD     $x3, 5
        SET     $y0, $dh
        ADD     $y0, 5
        SET     $y1, $y0
        ADD     $y1, $kh
        ADD     $y1, 5
        SET     $y2, $y1
        ADD     $y2, $kh
        ADD     $y2, 5
        SET     $y3, $y2
        ADD     $y3, $kh
        ADD     $y3, 5
        SET     $y4, $y3
        ADD     $y4, $kh
        ADD     $y4, 5
        SET     $tw, $view.w
        SUB     $tw, 16
        SET     $fw, $view.w
        SUB     $fw, 6

        ; the display
        FRAME   3, 3, $fw, $dh, 2, #000000
        TEXT    8, 12, $tw, 10, $expr, small, #000000, RIGHT
        TEXT    8, 28, $tw, 18, $text, big, #000000, RIGHT

        BOX     @k00, $x0, $y0, $kw, $kh, OPAQUE
        ON      CLICK, h_k00
        JNE     $box.pressed, 0, .k00_down
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 3, #000000
        TEXT    0, 0, $box.w, $box.h, "C", big, #000000, CENTER|MIDDLE
        JMP     .k00_done
.k00_down:
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "C", big, #FFFFFF, CENTER|MIDDLE
.k00_done:
        END
        BOX     @k01, $x1, $y0, $kw, $kh, OPAQUE
        ON      CLICK, h_k01
        JNE     $box.pressed, 0, .k01_down
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 3, #000000
        TEXT    0, 0, $box.w, $box.h, "+-", big, #000000, CENTER|MIDDLE
        JMP     .k01_done
.k01_down:
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "+-", big, #FFFFFF, CENTER|MIDDLE
.k01_done:
        END
        BOX     @k02, $x2, $y0, $kw, $kh, OPAQUE
        ON      CLICK, h_k02
        JNE     $box.pressed, 0, .k02_down
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 3, #000000
        TEXT    0, 0, $box.w, $box.h, "%", big, #000000, CENTER|MIDDLE
        JMP     .k02_done
.k02_down:
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "%", big, #FFFFFF, CENTER|MIDDLE
.k02_done:
        END
        BOX     @k03, $x3, $y0, $kw, $kh, OPAQUE
        ON      CLICK, h_k03
        JNE     $box.pressed, 0, .k03_down
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "/", big, #FFFFFF, CENTER|MIDDLE
        JMP     .k03_done
.k03_down:
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 3, #000000
        TEXT    0, 0, $box.w, $box.h, "/", big, #000000, CENTER|MIDDLE
.k03_done:
        END
        BOX     @k10, $x0, $y1, $kw, $kh, OPAQUE
        ON      CLICK, h_k10
        JNE     $box.pressed, 0, .k10_down
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 2, #000000
        TEXT    0, 0, $box.w, $box.h, "7", big, #000000, CENTER|MIDDLE
        JMP     .k10_done
.k10_down:
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "7", big, #FFFFFF, CENTER|MIDDLE
.k10_done:
        END
        BOX     @k11, $x1, $y1, $kw, $kh, OPAQUE
        ON      CLICK, h_k11
        JNE     $box.pressed, 0, .k11_down
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 2, #000000
        TEXT    0, 0, $box.w, $box.h, "8", big, #000000, CENTER|MIDDLE
        JMP     .k11_done
.k11_down:
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "8", big, #FFFFFF, CENTER|MIDDLE
.k11_done:
        END
        BOX     @k12, $x2, $y1, $kw, $kh, OPAQUE
        ON      CLICK, h_k12
        JNE     $box.pressed, 0, .k12_down
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 2, #000000
        TEXT    0, 0, $box.w, $box.h, "9", big, #000000, CENTER|MIDDLE
        JMP     .k12_done
.k12_down:
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "9", big, #FFFFFF, CENTER|MIDDLE
.k12_done:
        END
        BOX     @k13, $x3, $y1, $kw, $kh, OPAQUE
        ON      CLICK, h_k13
        JNE     $box.pressed, 0, .k13_down
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "x", big, #FFFFFF, CENTER|MIDDLE
        JMP     .k13_done
.k13_down:
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 3, #000000
        TEXT    0, 0, $box.w, $box.h, "x", big, #000000, CENTER|MIDDLE
.k13_done:
        END
        BOX     @k20, $x0, $y2, $kw, $kh, OPAQUE
        ON      CLICK, h_k20
        JNE     $box.pressed, 0, .k20_down
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 2, #000000
        TEXT    0, 0, $box.w, $box.h, "4", big, #000000, CENTER|MIDDLE
        JMP     .k20_done
.k20_down:
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "4", big, #FFFFFF, CENTER|MIDDLE
.k20_done:
        END
        BOX     @k21, $x1, $y2, $kw, $kh, OPAQUE
        ON      CLICK, h_k21
        JNE     $box.pressed, 0, .k21_down
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 2, #000000
        TEXT    0, 0, $box.w, $box.h, "5", big, #000000, CENTER|MIDDLE
        JMP     .k21_done
.k21_down:
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "5", big, #FFFFFF, CENTER|MIDDLE
.k21_done:
        END
        BOX     @k22, $x2, $y2, $kw, $kh, OPAQUE
        ON      CLICK, h_k22
        JNE     $box.pressed, 0, .k22_down
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 2, #000000
        TEXT    0, 0, $box.w, $box.h, "6", big, #000000, CENTER|MIDDLE
        JMP     .k22_done
.k22_down:
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "6", big, #FFFFFF, CENTER|MIDDLE
.k22_done:
        END
        BOX     @k23, $x3, $y2, $kw, $kh, OPAQUE
        ON      CLICK, h_k23
        JNE     $box.pressed, 0, .k23_down
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "-", big, #FFFFFF, CENTER|MIDDLE
        JMP     .k23_done
.k23_down:
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 3, #000000
        TEXT    0, 0, $box.w, $box.h, "-", big, #000000, CENTER|MIDDLE
.k23_done:
        END
        BOX     @k30, $x0, $y3, $kw, $kh, OPAQUE
        ON      CLICK, h_k30
        JNE     $box.pressed, 0, .k30_down
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 2, #000000
        TEXT    0, 0, $box.w, $box.h, "1", big, #000000, CENTER|MIDDLE
        JMP     .k30_done
.k30_down:
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "1", big, #FFFFFF, CENTER|MIDDLE
.k30_done:
        END
        BOX     @k31, $x1, $y3, $kw, $kh, OPAQUE
        ON      CLICK, h_k31
        JNE     $box.pressed, 0, .k31_down
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 2, #000000
        TEXT    0, 0, $box.w, $box.h, "2", big, #000000, CENTER|MIDDLE
        JMP     .k31_done
.k31_down:
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "2", big, #FFFFFF, CENTER|MIDDLE
.k31_done:
        END
        BOX     @k32, $x2, $y3, $kw, $kh, OPAQUE
        ON      CLICK, h_k32
        JNE     $box.pressed, 0, .k32_down
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 2, #000000
        TEXT    0, 0, $box.w, $box.h, "3", big, #000000, CENTER|MIDDLE
        JMP     .k32_done
.k32_down:
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "3", big, #FFFFFF, CENTER|MIDDLE
.k32_done:
        END
        BOX     @k33, $x3, $y3, $kw, $kh, OPAQUE
        ON      CLICK, h_k33
        JNE     $box.pressed, 0, .k33_down
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "+", big, #FFFFFF, CENTER|MIDDLE
        JMP     .k33_done
.k33_down:
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 3, #000000
        TEXT    0, 0, $box.w, $box.h, "+", big, #000000, CENTER|MIDDLE
.k33_done:
        END
        BOX     @k40, $x0, $y4, $kw, $kh, OPAQUE
        ON      CLICK, h_k40
        JNE     $box.pressed, 0, .k40_down
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 2, #000000
        TEXT    0, 0, $box.w, $box.h, "0", big, #000000, CENTER|MIDDLE
        JMP     .k40_done
.k40_down:
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "0", big, #FFFFFF, CENTER|MIDDLE
.k40_done:
        END
        BOX     @k41, $x1, $y4, $kw, $kh, OPAQUE
        ON      CLICK, h_k41
        JNE     $box.pressed, 0, .k41_down
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 2, #000000
        TEXT    0, 0, $box.w, $box.h, ".", big, #000000, CENTER|MIDDLE
        JMP     .k41_done
.k41_down:
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, ".", big, #FFFFFF, CENTER|MIDDLE
.k41_done:
        END
        BOX     @k42, $x2, $y4, $kw, $kh, OPAQUE
        ON      CLICK, h_k42
        JNE     $box.pressed, 0, .k42_down
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 3, #000000
        TEXT    0, 0, $box.w, $box.h, "<", big, #000000, CENTER|MIDDLE
        JMP     .k42_done
.k42_down:
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "<", big, #FFFFFF, CENTER|MIDDLE
.k42_done:
        END
        BOX     @k43, $x3, $y4, $kw, $kh, OPAQUE
        ON      CLICK, h_k43
        JNE     $box.pressed, 0, .k43_down
        FILL    #000000
        TEXT    0, 0, $box.w, $box.h, "=", big, #FFFFFF, CENTER|MIDDLE
        JMP     .k43_done
.k43_down:
        FILL    #FFFFFF
        RFRAME  0, 0, $box.w, $box.h, 6, 3, #000000
        TEXT    0, 0, $box.w, $box.h, "=", big, #000000, CENTER|MIDDLE
.k43_done:
        END
        END
        RET

h_k00:
        EMIT    "press", 99
        RET
h_k01:
        EMIT    "press", 110
        RET
h_k02:
        EMIT    "press", 37
        RET
h_k03:
        EMIT    "press", 47
        RET
h_k10:
        EMIT    "press", 55
        RET
h_k11:
        EMIT    "press", 56
        RET
h_k12:
        EMIT    "press", 57
        RET
h_k13:
        EMIT    "press", 42
        RET
h_k20:
        EMIT    "press", 52
        RET
h_k21:
        EMIT    "press", 53
        RET
h_k22:
        EMIT    "press", 54
        RET
h_k23:
        EMIT    "press", 45
        RET
h_k30:
        EMIT    "press", 49
        RET
h_k31:
        EMIT    "press", 50
        RET
h_k32:
        EMIT    "press", 51
        RET
h_k33:
        EMIT    "press", 43
        RET
h_k40:
        EMIT    "press", 48
        RET
h_k41:
        EMIT    "press", 46
        RET
h_k42:
        EMIT    "press", 98
        RET
h_k43:
        EMIT    "press", 61
        RET
